# Copie ce fichier en .env.local pour le développement local (npm i -g vercel && vercel dev),
# et configure les mêmes variables dans le dashboard Vercel (Settings > Environment Variables) pour la production.

# Obligatoire pour le chatbot IA : clé API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modèle utilisé par le chatbot (par défaut claude-opus-5 : le plus qualitatif).
# Pour réduire les coûts, tu peux passer à claude-sonnet-5 ou claude-haiku-4-5.
MODEL_NAME=claude-opus-5
MODEL_EFFORT=low

# Obligatoire pour l'envoi automatique des devis par email : clé API Resend (https://resend.com/, gratuit jusqu'à 3000 emails/mois)
RESEND_API_KEY=

# Adresse email PROFESSIONNELLE sur laquelle tu veux recevoir les demandes de devis
CONTACT_EMAIL=

# Adresse d'expédition autorisée par Resend (par défaut onboarding@resend.dev tant que ton domaine n'est pas vérifié sur Resend)
SEND_FROM_EMAIL=onboarding@resend.dev
